{
  "name": "oh-my-dsh-ui",
  "description": "客制化DSH（Custom DSH）· 单一整合插件: web-surface theming (accent, translucent surfaces), entrance motion, 中文优化 (zh), 丝滑流式 (smooth). Zero shell edits.",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yoli-mi/dsh-client-ui-custom.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-attachment"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "file:/Applications/DSH Desktop.app/Contents/Resources/app/node_modules/@deepseek-ai/cordis",
    "@deepseek-ai/dsh-api-remotes": "file:/Applications/DSH Desktop.app/Contents/Resources/app/node_modules/@deepseek-ai/dsh-api-remotes",
    "@deepseek-ai/dsh-client-locale": "file:/Applications/DSH Desktop.app/Contents/Resources/app/node_modules/@deepseek-ai/dsh-client-locale",
    "@deepseek-ai/dsh-client-ui-attachment": "file:/Applications/DSH Desktop.app/Contents/Resources/app/node_modules/@deepseek-ai/dsh-client-ui-attachment",
    "@deepseek-ai/dsh-client-ui-conversation": "file:/Applications/DSH Desktop.app/Contents/Resources/app/node_modules/@deepseek-ai/dsh-client-ui-conversation",
    "@deepseek-ai/dsh-client-ui-primitives": "file:/Applications/DSH Desktop.app/Contents/Resources/app/node_modules/@deepseek-ai/dsh-client-ui-primitives",
    "@deepseek-ai/dsh-client-ui-settings": "file:/Applications/DSH Desktop.app/Contents/Resources/app/node_modules/@deepseek-ai/dsh-client-ui-settings",
    "@deepseek-ai/dsh-client-ui-slots": "file:/Applications/DSH Desktop.app/Contents/Resources/app/node_modules/@deepseek-ai/dsh-client-ui-slots",
    "@deepseek-ai/dsh-invariants": "file:/Applications/DSH Desktop.app/Contents/Resources/app/node_modules/@deepseek-ai/dsh-invariants",
    "@deepseek-ai/dsh-settings": "file:/Applications/DSH Desktop.app/Contents/Resources/app/node_modules/@deepseek-ai/dsh-settings",
    "@deepseek-ai/schemastery": "file:/Applications/DSH Desktop.app/Contents/Resources/app/node_modules/@deepseek-ai/schemastery",
    "@tsdown/css": "^0.22.14",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "jsdom": "^30.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "latest",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/*.d.ts",
    "cordis.patch.yml"
  ]
}
